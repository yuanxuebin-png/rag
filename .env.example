# 复制为 .env 并填写。没有 key 也能跑: 检索与拒答判定是纯本地的,
# 只有「生成答案」一步需要 LLM, 评测有 --offline 模式可跳过。

# DeepSeek(OpenAI 兼容协议)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选: SiliconFlow 的 embedding(BGE-M3)。不配则自动退化为纯 BM25 检索。
# SILICONFLOW_API_KEY=sk-xxx

# 生成答案的模型名
RAG_MODEL=deepseek-chat

# 模型超时(秒)
MODEL_TIMEOUT=60
